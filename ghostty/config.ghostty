# Use the non-Mono JetBrainsMono Nerd Font so powerline separators (e.g. the
# rounded caps) render at their natural double-width and stay rounded.
# The "Mono" variant force-fits every glyph into one cell and clips the curves.
font-family = "JetBrainsMono Nerd Font"
font-size = 11

# --- Black glass look ----------------------------------------------------
# Translucent window with a near-black tint and a blurred backdrop so the
# terminal reads like a pane of smoked glass. background-opacity is the
# see-through amount; background-blur frosts whatever is behind it (needs a
# compositor that supports it: KWin/KDE, Hyprland, macOS). Cinnamon will
# honor opacity but ignore the blur radius.
background-opacity = 0.90
background-blur = 64

# --- Gruvbox dark colorscheme (morhetz) ---------------------------------
# background pushed toward black (from gruvbox bg0 #282828) so the tint stays
# dark and glassy rather than washing out warm-gray when the wallpaper shows through.
background = #0d0e0f
foreground = #ebdbb2
cursor-color = #ebdbb2
cursor-text = #282828
selection-background = #ebdbb2
selection-foreground = #282828

# normal
palette = 0=#282828
palette = 1=#cc241d
palette = 2=#98971a
palette = 3=#d79921
palette = 4=#458588
palette = 5=#b16286
palette = 6=#689d6a
palette = 7=#a89984
# bright
palette = 8=#928374
palette = 9=#fb4934
palette = 10=#b8bb26
palette = 11=#fabd2d
palette = 12=#83a598
palette = 13=#d3869b
palette = 14=#8ec07c
palette = 15=#ebdbb2

# Ghostty does not expand ${HOME} in env= values — a prior PATH= override
# put the literal string "${HOME}/.local/bin" on PATH, so go/zoxide/iris
# 404'd at startup. User bins are prepended in ~/.profile before bashrc.

# --- Tab bar -------------------------------------------------------------
# Kitty powerline + slanted is parallelograms joined by . Ghostty's GTK tabs
# have no powerline renderer; tabs.css paints one parallelogram SVG per tab
# (yellow active, #282828 inactive), bar along the bottom.
window-decoration = server
gtk-titlebar = false
gtk-tabs-location = bottom
gtk-toolbar-style = flat
gtk-wide-tabs = false
gtk-custom-css = ~/.config/ghostty/tabs.css

# ── Bell ──────────────────────────────────────────────
# Silence the terminal bell (backspace on empty line, invalid actions, etc.)
bell-features = no-audio,no-system,no-attention,no-title,no-border
