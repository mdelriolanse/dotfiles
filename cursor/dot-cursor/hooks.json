{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "./hooks/ocr-served"
      },
      {
        "command": "./hooks/ponytail-session-start"
      },
      {
        "command": "bash \"$HOME/.cursor/herdr-agent-state.sh\" session"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "./hooks/ponytail-before-submit",
        "matcher": "UserPromptSubmit"
      }
    ]
  }
}
