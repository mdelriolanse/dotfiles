{
  "mcpServers": {
    "context7": {
      "url": "https://mcp.context7.com/mcp"
    },
    "agentmemory": {
      "command": "npx",
      "args": ["-y", "@agentmemory/mcp@0.9.27"],
      "env": {
        "PATH": "${NODE_BIN_PATH}:/usr/bin:/bin",
        "AGENTMEMORY_URL": "http://localhost:3111",
        "AGENTMEMORY_TOOLS": "all",
        "AGENTMEMORY_SECRET": "${AGENTMEMORY_SECRET}"
      }
    },
    "browserbase": {
      "command": "npx",
      "args": [
        "-y",
        "@browserbasehq/mcp",
        "--modelName",
        "google/gemini-flash-latest",
        "--modelApiKey",
        "${GEMINI_API_KEY}"
      ],
      "env": {
        "PATH": "${NODE_BIN_PATH}:/usr/bin:/bin",
        "BROWSERBASE_API_KEY": "${BROWSERBASE_API_KEY}",
        "BROWSERBASE_PROJECT_ID": "${BROWSERBASE_PROJECT_ID}",
        "GEMINI_API_KEY": "${GEMINI_API_KEY}"
      }
    },
    "firecrawl-mcp": {
      "command": "npx",
      "args": ["-y", "firecrawl-mcp"],
      "env": {
        "PATH": "${NODE_BIN_PATH}:/usr/bin:/bin",
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
      }
    },
    "excalidraw": {
      "command": "npx",
      "args": ["-y", "mcp-excalidraw-server"],
      "env": {
        "PATH": "${NODE_BIN_PATH}:/usr/bin:/bin"
      }
    },
    "quiverai": {
      "url": "https://app.quiver.ai/mcp",
      "env": {
        "QUIVERAI_API_KEY": "${QUIVERAI_API_KEY}"
      }
    },
    "fetch": {
      "command": "npx",
      "args": ["-y", "html-extractor-mcp"],
      "env": {
        "PATH": "${NODE_BIN_PATH}:/usr/bin:/bin"
      }
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "PATH": "${NODE_BIN_PATH}:/usr/bin:/bin",
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "codebase-memory": {
      "command": "${HOME}/.local/bin/codebase-memory-mcp"
    },
    "serena": {
      "command": "serena",
      "args": ["start-mcp-server", "--context", "ide", "--project-from-cwd"],
      "env": {
        "PATH": "${HOME}/.local/bin:/usr/bin:/bin"
      }
    },
    "semble": {
      "command": "uvx",
      "args": ["--from", "semble[mcp]", "semble", "mcp-server"],
      "env": {
        "PATH": "/usr/local/bin:/usr/bin:/bin"
      }
    }
  }
}
