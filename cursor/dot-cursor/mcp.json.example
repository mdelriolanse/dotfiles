{
  "mcpServers": {
    "context7": {
      "url": "https://mcp.context7.com/mcp"
    },
    "firecrawl-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "firecrawl-mcp"
      ],
      "env": {
        "PATH": "${NODE_BIN_PATH}:/usr/bin:/bin",
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
      }
    },
    "fetch": {
      "command": "npx",
      "args": [
        "-y",
        "html-extractor-mcp"
      ],
      "env": {
        "PATH": "${NODE_BIN_PATH}:/usr/bin:/bin"
      }
    }
  }
}
