{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "model": "<provider>/glm-5-2-nvfp4",
  "agent": {
    "coder": {},
    "architect": {},
    "build": {
      "mode": "primary",
      "steps": 200
    },
    "plan": {
      "mode": "primary",
      "steps": 200
    },
    "general": {
      "mode": "subagent",
      "steps": 100
    },
    "explore": {
      "mode": "subagent",
      "steps": 100
    },
    "scout": {
      "mode": "subagent",
      "steps": 100
    }
  },
  "permission": "allow",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "agentmemory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@agentmemory/mcp@0.9.27"
      ],
      "environment": {
        "AGENTMEMORY_URL": "http://localhost:3111",
        "AGENTMEMORY_TOOLS": "all"
      },
      "enabled": true
    },
    "fetch": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "html-extractor-mcp"
      ]
    },
    "github": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "environment": {
        "GITHUB_TOKEN": "{env:GITHUB_TOKEN}"
      }
    },
    "codebase-memory": {
      "type": "local",
      "command": [
        "codebase-memory-mcp"
      ],
      "enabled": true
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "serena": {
      "type": "local",
      "command": [
        "serena",
        "start-mcp-server",
        "--context",
        "ide",
        "--project-from-cwd"
      ],
      "enabled": true
    },
    "semble": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "semble[mcp]",
        "semble"
      ],
      "enabled": true
    }
  },
  "instructions": [
    "instructions/mcp-first.md",
    "instructions/tool-names.md",
    "AGENTS.md",
    "instructions/agentmemory-conventions.md",
    "instructions/memory-first-codebase.md",
    "instructions/discovery-protocol.md",
    "instructions/never-push.md",
    "instructions/shared-machine.md",
    "instructions/chinese-model-english.md",
    "instructions/karpathy-guidelines.md",
    "instructions/context-efficiency.md",
    "instructions/gh-cli-preference.md",
    "instructions/commit-message-style.md",
    "instructions/commit-hygiene.md",
    "instructions/ponytail-scope.md",
    "instructions/output-concision.md"
  ],
  "skills": {
    "paths": [
      "skills"
    ]
  },
  "provider": {
    "anthropic": {
      "options": {
        "setCacheKey": true
      }
    },
    "<provider>": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "<Provider>",
      "options": {
        "baseURL": "https://<provider-host>/v1"
      },
      "models": {
        "nvidia-kimi-k2-6-nvfp4": {
          "name": "Kimi-K2.6",
          "cost": {
            "input": 0.95,
            "output": 4.0,
            "cache_read": 0.16
          },
          "limit": {
            "context": 262144,
            "output": 262144
          },
          "tool_call": true,
          "reasoning": true,
          "modalities": {
            "input": [
              "text",
              "image",
              "video"
            ],
            "output": [
              "text"
            ]
          }
        },
        "glm-5-2-nvfp4": {
          "name": "GLM 5.2",
          "cost": {
            "input": 0.5,
            "output": 1.5
          },
          "limit": {
            "context": 262144,
            "output": 262144
          },
          "tool_call": true,
          "reasoning": true,
          "options": {
            "reasoningEffort": "high"
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "tail_turns": 2,
    "preserve_recent_tokens": 8000
  },
  "lsp": {
    "python": {
      "command": [
        "pyright-langserver",
        "--stdio"
      ],
      "extensions": [
        ".py"
      ]
    },
    "c": {
      "command": [
        "clangd"
      ],
      "extensions": [
        ".c",
        ".h"
      ]
    },
    "cpp": {
      "command": [
        "clangd"
      ],
      "extensions": [
        ".cpp",
        ".cc",
        ".cxx",
        ".hpp"
      ]
    },
    "typescript": {
      "command": [
        "typescript-language-server",
        "--stdio"
      ],
      "extensions": [
        ".ts",
        ".tsx"
      ]
    },
    "rust": {
      "command": [
        "rust-analyzer"
      ],
      "extensions": [
        ".rs"
      ]
    }
  },
  "plugin": [
    "./plugins/ponytail-bridge.ts",
    "./plugins/ssh-agent-bridge.ts"
  ],
  "shell": "/bin/bash"
}
