{
  "$schema": "https://opencode.ai/config.json",

  // Disable auto-update check on startup
  "autoupdate": false,

  // Model preferences
  "model": "<provider>/deepseek-v4-pro",

  // Agent configurations
  "agent": {
    "coder": {},
    "architect": {},
    "build": {
      "mode": "primary",
      "steps": 200
    },
    "plan": {
      "mode": "primary",
      "steps": 200
    },
    "general": {
      "mode": "subagent",
      "steps": 100
    },
    "explore": {
      "mode": "subagent",
      "steps": 100
    },
    "scout": {
      "mode": "subagent",
      "steps": 100
    }
  },

  // Permission rules
  "permission": "allow",

  // MCP server configurations (also loaded from mcp/*.json files)

  "mcp": {
    "context7": {
    "type": "remote",
    "url": "https://mcp.context7.com/mcp",
    "enabled": true
  },
    "agentmemory": {
      "type": "local",
      "command": ["npx", "-y", "@agentmemory/mcp@0.9.27"],
      "environment": {
        "AGENTMEMORY_URL": "http://localhost:3111",
        "AGENTMEMORY_TOOLS": "all"
      },
      "enabled": true
    },

    "fetch": {
      "type": "local",
      "command": ["npx", "-y", "html-extractor-mcp"]
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "environment": {
        "GITHUB_TOKEN": "{env:GITHUB_TOKEN}"
      }
    },
    "codebase-memory": {
      "type": "local",
      "command": ["$HOME/.local/bin/codebase-memory-mcp"],
      "enabled": true
    }
  },

    // Files auto-included in AI context (prompt-cached, included once)
    "instructions": [
        "instructions/output-concision.md",
        "instructions/context-efficiency.md",
        "instructions/agentmemory-conventions.md",
        "instructions/memory-first-codebase.md",
        "instructions/discovery-protocol.md",
        "instructions/never-push.md",
        "instructions/shared-machine.md",
        "instructions/chinese-model-english.md",
        "instructions/karpathy-guidelines.md",
        "instructions/gh-cli-preference.md"
    ],

    // Skill discovery paths (for slash-command autocomplete)
    "skills": {
        "paths": ["skills"]
    },

  // Provider configuration
  "provider": {
    "anthropic": {
      "options": {
        "setCacheKey": true
      }
    },
    "<provider>": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "<Provider>",
      "options": {
        "baseURL": "https://<provider-host>/v1"
      },
      "models": {
        "deepseek-v4-pro": {
          "name": "DeepSeek-V4-Pro",
          "limit": {
            "context": 1048576,
            "output": 262144
          },
          "tool_call": true,
          "reasoning": true,
          "options": {
            "reasoningEffort": "high",
            "thinking": {
              "type": "enabled"
            }
          }
        },
        "nvidia-kimi-k2-6-nvfp4": {
          "name": "Kimi-K2.6",
          "cost": { "input": 0.95, "output": 4.00, "cache_read": 0.16 },
          "limit": { "context": 262144, "output": 262144},
          "tool_call": true,
          "reasoning": true,
          "modalities": {"input": ["text", "image", "video"], "output": ["text"] }
        }
      }
    }
  },

  // Compaction: keep context lean
  "compaction": {
    "auto": true,
    "tail_turns": 2,
    "preserve_recent_tokens": 8000
  },

  // LSP configurations
  "lsp": {
    "python": {
      "command": ["pyright-langserver", "--stdio"],
      "extensions": [".py"]
    },
    "c": {
      "command": ["clangd"],
      "extensions": [".c", ".h"]
    },
    "cpp": {
      "command": ["clangd"],
      "extensions": [".cpp", ".cc", ".cxx", ".hpp"]
    },
    "typescript": {
      "command": ["typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx"]
    },
    "rust": {
      "command": ["rust-analyzer"],
      "extensions": [".rs"]
    }
  },

  // Plugins
  "plugin": [
    "./plugins/ponytail-bridge.ts"
  ],

  // Shell configuration
  "shell": "/bin/bash"
}
