# ============================================================================
# Secrets — NEVER commit these. They live on disk (gitignored) and are
# hand-copied / regenerated per machine. See secrets/secrets.env.example.
# ============================================================================
secrets/secrets.env
# Real configs that hold materialized API keys; only *.example is tracked.
# Generated from the .example + secrets.env via envsubst (see install.sh).
cursor/dot-cursor/mcp.json
claude/mcp.json
# Hermes real config/.env hold live keys; only the *.example templates are tracked.
# install.sh materializes these from the examples + secrets.env, then symlinks them.
hermes/config.yaml
hermes/.env
# Cron/agent scripts stay machine-local; not centralized.
hermes/scripts/

# ============================================================================
# Transient / machine-generated
# ============================================================================
**/node_modules/
*.bak
__pycache__/
*.pyc
*.bak.*

# Cursor heavy state / binaries (never centralized, listed defensively)
cursor/dot-cursor/extensions/
cursor/dot-cursor/projects/
cursor/dot-cursor/worktrees/
cursor/dot-cursor/ai-tracking/
cursor/dot-cursor/.claude/
cursor/dot-cursor/statsig-cache.json
cursor/dot-cursor/ide_state.json
cursor/User/globalStorage/
cursor/User/History/
cursor/User/workspaceStorage/

# Project-specific agent plans — never centralize
cursor/dot-cursor/plans/

# Claude Code session worktrees (git worktree checkouts, ephemeral/machine-local)
.claude/worktrees/

# Stray MCP server log
excalidraw.log

# Machine-local cargo-dist receipt (install_prefix is host-specific)
nvim/ruff/ruff-receipt.json

# Live Codex config holds MCP secrets; only harness.toml is tracked
codex/config.toml
