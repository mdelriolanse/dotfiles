{
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "model": "sonnet",
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "claude-hud@claude-hud": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "directory",
        "path": "~/dotfiles/opencode/ponytail"
      }
    },
    "claude-hud": {
      "source": {
        "source": "directory",
        "path": "~/dotfiles/opencode/claude-hud"
      }
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-ansi"
}
