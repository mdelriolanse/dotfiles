# ~/.bashrc: executed by bash(1) for non-login shells.
# see /usr/share/doc/bash/examples/startup-files (in the package bash-doc)
# for examples

# If not running interactively, don't do anything
case $- in
    *i*) ;;
      *) return;;
esac

# User bins + /usr/local/bin before iris/go/zoxide/starship. Ghostty's
# posix inject may skip ~/.profile; a GUI session can also hand us a
# brew-only PATH. ${HOME} in Ghostty env= is literal, so don't rely on it.
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) PATH="$HOME/.local/bin${PATH:+:$PATH}" ;; esac
case ":$PATH:" in *":$HOME/bin:"*) ;; *) PATH="$HOME/bin${PATH:+:$PATH}" ;; esac
for d in /usr/local/bin /usr/bin /bin; do
  case ":$PATH:" in *":$d:"*) ;; *) PATH="${PATH:+$PATH:}$d" ;; esac
done
export PATH

# SSH: use the local Cinnamon display when X11 isn't forwarded, so xclip
# (nvim yank, tmux copy) hits this machine's clipboard. ssh -X keeps DISPLAY.
if [ -n "${SSH_CONNECTION:-}" ]; then
  export XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}"
  if [ -z "${DISPLAY:-}" ]; then
    export DISPLAY=:0
  fi
fi

# IRIS autostart (gruvbox build, see dotfiles/iris/build.sh). `iris init bash`
# execs iris, which re-runs this file inside its PTY with IRIS_PID set — the
# second pass falls through to the precmd hook instead of exec'ing again.
# Escape hatch if it ever wedges the prompt: IRIS_RESCUE=1 bash
# The BASH_EXECUTION_STRING guard keeps `bash -ic '...'` callers from being
# hijacked into the interactive overlay; without it they exec iris and hang.
# Children spawned outside iris's PTY (Claude Code, editors) inherit IRIS_FD in
# the environment but not the open descriptor, so the precmd hook writes to a
# dead fd and bash prints "$IRIS_FD: Bad file descriptor" before the hook's own
# 2>/dev/null can suppress it. Drop the stale var when the fd isn't really open.
[ -n "${IRIS_FD:-}" ] && ! { : >&"$IRIS_FD"; } 2>/dev/null && unset IRIS_FD

# Herdr identifies agents from the pane's foreground process group. iris keeps
# the TTY, so cursor-agent (and every other agent) looks like "iris" and never
# enters the sidebar — even though the cursor session hook already fires.
# Skip the overlay inside herdr panes; keep it for kitty/normal shells.
if [ -z "${BASH_EXECUTION_STRING:-}" ] \
  && [ "${HERDR_ENV:-}" != "1" ] \
  && command -v iris >/dev/null 2>&1; then
  eval "$(iris init bash)"
fi

# The probe above isn't enough: a nested shell can inherit a live fd 13 that
# belongs to someone else (node reuses low fds), so the hook still installs and
# then fails at the first prompt. iris writes it as `>&$IRIS_FD 2>/dev/null`,
# and bash applies redirections left to right, so the failure is reported to the
# still-live stderr before 2>/dev/null takes effect. Redefine with stderr
# silenced first. ponytail: override here, not a patched fork of iris.
declare -F _iris_bash_precmd >/dev/null &&
  _iris_bash_precmd() { printf 'IRIS_CMD_STOP\x00' 2>/dev/null >&$IRIS_FD; }

# ble.sh — bash line editor. Enables starship's right-side prompt (right_format),
# which stock bash can't draw. Sourced with --noattach here; ble-attach runs at
# the very end of this file (after starship init) so it picks up the prompt.
[[ -f "$HOME/.local/share/blesh/ble.sh" ]] && source "$HOME/.local/share/blesh/ble.sh" --noattach

# don't put duplicate lines or lines starting with space in the history.
# See bash(1) for more options
HISTCONTROL=ignoreboth

# append to the history file, don't overwrite it
shopt -s histappend

# for setting history length see HISTSIZE and HISTFILESIZE in bash(1)
HISTSIZE=1000
HISTFILESIZE=2000

# check the window size after each command and, if necessary,
# update the values of LINES and COLUMNS.
shopt -s checkwinsize

# If set, the pattern "**" used in a pathname expansion context will
# match all files and zero or more directories and subdirectories.
#shopt -s globstar

# make less more friendly for non-text input files, see lesspipe(1)
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# set variable identifying the chroot you work in (used in the prompt below)
if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
    debian_chroot=$(cat /etc/debian_chroot)
fi

# set a fancy prompt (non-color, unless we know we "want" color)
case "$TERM" in
    xterm-color|*-256color) color_prompt=yes;;
esac

# uncomment for a colored prompt, if the terminal has the capability; turned
# off by default to not distract the user: the focus in a terminal window
# should be on the output of commands, not on the prompt
#force_color_prompt=yes

if [ -n "$force_color_prompt" ]; then
    if [ -x /usr/bin/tput ] && tput setaf 1 >&/dev/null; then
	# We have color support; assume it's compliant with Ecma-48
	# (ISO/IEC-6429). (Lack of such support is extremely rare, and such
	# a case would tend to support setf rather than setaf.)
	color_prompt=yes
    else
	color_prompt=
    fi
fi

if [ "$color_prompt" = yes ]; then
    PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
else
    PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
fi
unset color_prompt force_color_prompt

# If this is an xterm set the title to user@host:dir
case "$TERM" in
xterm*|rxvt*)
    PS1="\[\e]0;${debian_chroot:+($debian_chroot)}\u@\h: \w\a\]$PS1"
    ;;
*)
    ;;
esac

# enable color support of ls and also add handy aliases
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    #alias dir='dir --color=auto'
    #alias vdir='vdir --color=auto'

    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi

# colored GCC warnings and errors
#export GCC_COLORS='error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01'

# some more ls aliases
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

# Add an "alert" alias for long running commands.  Use like so:
#   sleep 10; alert
alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'

# Alias definitions.
# You may want to put all your additions into a separate file like
# ~/.bash_aliases, instead of adding them here directly.
# See /usr/share/doc/bash-doc/examples in the bash-doc package.

if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

# enable programmable completion features (you don't need to enable
# this, if it's already enabled in /etc/bash.bashrc and /etc/profile
# sources /etc/bash.bashrc).
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

# =============================================================================
# User customizations (reconstructed from truncated original)
# =============================================================================

# Homebrew (skip if not installed)
if [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv bash)"
elif [ -x "$HOME/.linuxbrew/Homebrew/bin/brew" ]; then
  export PATH="$HOME/.linuxbrew/Homebrew/bin:$PATH"
  export HOMEBREW_PREFIX="$HOME/.linuxbrew"
  export HOMEBREW_NO_INSTALLED_DEPENDENTS_CHECK=1
fi

# NVM (Node Version Manager)
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"


# Quartus
export PATH="$PATH:/opt/Quartus/quartus/bin"

# Go
if command -v go >/dev/null 2>&1; then
  export PATH="$PATH:$(go env GOPATH)/bin"
fi

# Android Studio / SDK
export ANDROID_HOME="$HOME/Android/Sdk"
export PATH="$PATH:$ANDROID_HOME/emulator:$ANDROID_HOME/platform-tools:$ANDROID_HOME/cmdline-tools/latest/bin"

# API keys (Anthropic, GitHub, Browserbase, Linear, agentmemory, …) live ONLY
# in the gitignored ~/dotfiles/secrets/secrets.env, sourced near the end of this
# file. Never inline real keys here — this file is tracked in the dotfiles repo.

# opencode
export PATH="$HOME/.opencode/bin:$PATH"
alias opcd='opencode'

# Rust / Cargo
export PATH="$HOME/.cargo/bin:$PATH"

# Podman / Ollama
alias pstart='podman start'
alias pstop='podman stop'
alias ollama-stop='podman compose -f /opt/ollama-intel-arc/docker-compose.yml down'

# Other aliases
alias nh='nohup'
alias py='python3'
alias c='clear'

alias cldsp='claude --dangerously-skip-permissions'

# IRIS — inline shell completion menu (gruvbox build, see dotfiles/iris/build.sh).
# Launch it explicitly; it takes over the TTY, so it is not auto-started.
command -v iris >/dev/null 2>&1 && alias i='iris'

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

export AGENTMEMORY_URL=http://localhost:3111
export USER_ID=bob
export TEAM_ID=developer-relations

command -v starship >/dev/null 2>&1 && eval "$(starship init bash)"
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init bash --cmd cd)"

# Load dotfiles secrets (gitignored)
[ -f "$HOME/dotfiles/secrets/secrets.env" ] && set -a && . "$HOME/dotfiles/secrets/secrets.env" && set +a
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# Attach ble.sh (must be last, after starship init) so the right-side prompt renders.
[[ ${BLE_VERSION-} ]] && ble-attach
