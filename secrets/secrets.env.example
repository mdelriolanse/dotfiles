# Dotfiles secrets — TEMPLATE.
#
#   cp secrets.env.example secrets.env   &&   $EDITOR secrets.env
#
# secrets.env is gitignored and NEVER committed/pushed. install.sh wires
# ~/.bashrc to source it, so tools that reference {env:VAR} (opencode) or
# ${VAR} can resolve the values, and install.sh uses it to materialize the
# real Cursor mcp.json from its *.example template.

# Node bin dir for Cursor MCP servers launched via npx (see mcp.json.example).
# Leave empty to let install.sh auto-detect via `command -v node`.
export NODE_BIN_PATH=

# --- MCP / agentic-tool keys ---
export BROWSERBASE_API_KEY=
export BROWSERBASE_PROJECT_ID=
export GEMINI_API_KEY=
export AGENTMEMORY_SECRET=
export GITHUB_TOKEN=
export PROVIDER_API_KEY=
# --- Other dev keys (carried over for convenience on a new machine) ---
export GH_TOKEN=
export ANTHROPIC_API_KEY=

# --- Hermes agent (~/.hermes) ---
# install.sh materializes ~/.hermes/config.yaml and ~/.hermes/.env from the
# hermes/*.example templates using these values.
export HERMES_MODEL_API_KEY=        # DeepInfra (or chosen provider) API key -> config.yaml
export TELEGRAM_BOT_TOKEN=          # From @BotFather
export TELEGRAM_ALLOWED_USERS=      # Comma-separated Telegram user IDs
export TELEGRAM_HOME_CHANNEL=       # Default chat/user ID for cron delivery
export TELEGRAM_HOME_CHANNEL_NAME=  # Display name for home channel
# AGENTMEMORY_SECRET (above) is also consumed by ~/.hermes/config.yaml.
